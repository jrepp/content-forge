{
  "name": "content-forge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Content-production seam between Blockbench+automation (producer) and Minosoft (consumer).",
  "scripts": {
    "config": "node scripts/config.mjs",
    "pull-queue": "node scripts/pull-queue.mjs",
    "triage": "node scripts/triage.mjs",
    "taxonomy": "node scripts/model-taxonomy.mjs",
    "synth-models": "node producers/model/synth.mjs",
    "synth-textures": "node producers/raster/synth-textures.mjs",
    "db": "node scripts/db.mjs",
    "feedback": "node scripts/visual-feedback.mjs",
    "generate": "node scripts/generate.mjs",
    "publish": "node scripts/publish.mjs",
    "reference-closure": "node producers/raster/reference-closure.mjs",
    "synth-textures-all": "node producers/raster/synth-textures.mjs --all",
    "resolve-candidates": "node producers/model/resolve-candidates.mjs",
    "gate": "node scripts/db.mjs gate",
    "release": "node scripts/release.mjs",
    "author-tree": "node producers/blockbench/author-tree.mjs",
    "instantiate": "node producers/model/instantiate.mjs",
    "audit": "node scripts/audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "review:cohort": "node scripts/review-sheet.mjs",
    "review:browser-check": "node scripts/review/browser-check.mjs",
    "items:plan": "node scripts/item-families.mjs",
    "items:author": "node producers/blockbench/item-family.mjs author",
    "items:export": "node producers/blockbench/item-family.mjs export",
    "hosting:check": "turbo-ogre check --file hosting.json",
    "hosting:bundle": "node scripts/hosting-bundle.mjs",
    "hosting:register": "turbo-ogre register --file hosting.json",
    "hosting:status": "turbo-ogre status",
    "hosting:publish": "turbo-ogre publish --artifact review-site.tar.gz --file work/hosting/review-site.tar.gz"
  },
  "devDependencies": {
    "@turbo-ogre/sdk": "https://codeload.github.com/turbo-ogre/sdk/tar.gz/d4f78b92f88f63f1edf44a6ad4955bcdbf7d799e"
  }
}
